{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      "**/.*/**",
      ".firebaserc",
      ".git",
      ".git/**",
      "UTMUTATO.md",
      "firebase.json",
      "firestore.rules",
      "functions",
      "functions/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ]
}