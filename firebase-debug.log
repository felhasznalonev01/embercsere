[debug] [2026-11-09T09:21:48.615Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/emberecsere/rulesets {"name":"projects/emberecsere/rulesets/6c89e9aa-3cb5-4309-ad3b-d6f17908be13","source":{"files":[{"content":"rules_version = '2';\n\n// Embercsere + Szolgálatbeosztás – Firestore biztonsági szabályok.\n// Ha a config.js-ben átírod a fiókok e-mail címét, itt is írd át ugyanúgy!\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Osztályvezetők fiókjai\n    function leaderClass() {\n      return {\n        'osztaly1@example.com': 'o1',\n        'osztaly2@example.com': 'o2',\n        'osztaly3@example.com': 'o3',\n        'osztaly4@example.com': 'o4'\n      }.get(request.auth.token.email, 'nincs');\n    }\n    // Dolgozói (közös) fiókok\n    function workerClass() {\n      return {\n        'dolgozo1@example.com': 'o1',\n        'dolgozo2@example.com': 'o2',\n        'dolgozo3@example.com': 'o3',\n        'dolgozo4@example.com': 'o4'\n      }.get(request.auth.token.email, 'nincs');\n    }\n    // Szolgálatvezetés: minden osztályt lát, írni csak a szolgálati sorrendet tudja\n    function isAdmin() { return request.auth != null && request.auth.token.email == 'vezeto@example.com'; }\n    function isLeader() { return request.auth != null && leaderClass() != 'nincs'; }\n    function isWorker() { return request.auth != null && workerClass() != 'nincs'; }\n    function inClass(cid) { return (isLeader() && leaderClass() == cid) || (isWorker() && workerClass() == cid); }\n    function leaderOf(cid) { return isLeader() && leaderClass() == cid; }\n    function req(id) { return get(/databases/$(database)/documents/requests/$(id)).data; }\n    function d() { return request.resource.data; }\n\n    // ---------------- Embercsere: csak osztályvezetők\n    match /requests/{requestId} {\n      allow read: if isLeader() || isAdmin();\n      allow create: if isLeader()\n        && d().keys().hasOnly(['classId', 'date', 'shift', 'qty', 'note', 'createdAt'])\n        && d().classId == leaderClass()\n        && d().date is string && d().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\n        && d().shift is string && d().shift.size() <= 20\n        && d().qty is list && d().qty.size() <= 10\n        && d().note is string && d().note.size() <= 500\n        && d().createdAt == request.time;\n      allow delete: if leaderOf(resource.data.classId);\n      allow update: if false;\n    }\n\n    match /offers/{offerId} {\n      allow read: if isLeader() || isAdmin();\n      allow create: if isLeader()\n        && d().keys().hasOnly(['requestId', 'roleIndex', 'slot', 'classId', 'person', 'personId', 'date', 'shift', 'toClassId', 'createdAt'])\n        && d().classId == leaderClass()\n        && d().person is string && d().person.size() > 0 && d().person.size() <= 100\n        && d().personId is string && d().personId.size() <= 60\n        && d().roleIndex is int && d().roleIndex >= 0\n        && d().slot is int && d().slot >= 0\n        && offerId == d().requestId + '_' + string(d().roleIndex) + '_' + string(d().slot)\n        && req(d().requestId).classId != leaderClass()\n        && d().toClassId == req(d().requestId).classId\n        && d().date == req(d().requestId).date\n        && d().shift == req(d().requestId).shift\n        && d().roleIndex < req(d().requestId).qty.size()\n        && d().slot < req(d().requestId).qty[d().roleIndex]\n        && d().createdAt == request.time;\n      // Visszavonhatja aki adta, vagy akinek a kérése (régi felajánlásnál a kérésből nézzük)\n      allow delete: if isLeader()\n        && (resource.data.classId == leaderClass()\n            || resource.data.get('toClassId', req(resource.data.requestId).classId) == leaderClass());\n      // Az adó osztály vezetője kiegészítheti: dátum / napszak / kérő osztály (a kérésből), és névsorhoz kapcsolhatja\n      allow update: if isLeader() && resource.data.classId == leaderClass()\n        && d().diff(resource.data).affectedKeys().hasOnly(['date', 'shift', 'toClassId', 'personId'])\n        && d().date == req(resource.data.requestId).date\n        && d().shift == req(resource.data.requestId).shift\n        && d().toClassId == req(resource.data.requestId).classId\n        && d().personId is string && d().personId.size() <= 60;\n    }\n\n    // ---------------- Névsor: vezető szerkeszti, a dolgozók csak olvassák (a saját osztályukét)\n    match /people/{personId} {\n      allow read: if inClass(resource.data.classId) || isAdmin();\n      allow create: if leaderOf(d().classId)\n        && d().keys().hasOnly(['classId', 'name', 'pattern', 'role', 'active', 'leaveDays', 'exams', 'order', 'createdAt'])\n        && d().name is string && d().name.size() > 0 && d().name.size() <= 80\n        && d().pattern in ['12', '24'];\n      allow update: if leaderOf(resource.data.classId) && d().classId == resource.data.classId\n        && d().keys().hasOnly(['classId', 'name', 'pattern', 'role', 'active', 'leaveDays', 'exams', 'order', 'createdAt'])\n        && d().name is string && d().name.size() > 0 && d().name.size() <= 80\n        && d().pattern in ['12', '24'];\n      allow delete: if leaderOf(resource.data.classId);\n    }\n\n    // ---------------- Beosztás: havonta egy dokumentum osztályonként (\"o1_2026-11\"), csak a vezető\n    match /roster/{docId} {\n      allow read: if (isLeader() && docId.split('_')[0] == leaderClass()) || isAdmin();\n      allow write: if isLeader() && docId == leaderClass() + '_' + d().month\n        && d().classId == leaderClass()\n        && d().month is string && d().month.matches('^[0-9]{4}-[0-9]{2}$');\n    }\n\n    // ---------------- Osztály-beállítások (napi cél-létszám)\n    match /classSettings/{cid} {\n      allow read: if leaderOf(cid) || isAdmin();\n      allow write: if leaderOf(cid) && d().classId == cid\n        && d().get('targetDay', 0) is number && d().get('targetNight', 0) is number && d().get('target', 0) is number;\n    }\n\n    // ---------------- Szolgálati sorrend (melyik nap melyik osztály van szolgálatban)\n    match /settings/rotation {\n      allow read: if isLeader() || isWorker() || isAdmin();\n      allow write: if isAdmin()\n        && d().keys().hasOnly(['start', 'order'])\n        && d().start is string && d().start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')\n        && d().order is list && d().order.size() >= 1 && d().order.size() <= 10;\n    }\n\n    // ---------------- Túlóra-korlát és célarány (csak a szolgálatvezetés állítja)\n    match /settings/limits {\n      allow read: if isLeader() || isAdmin();\n      allow write: if isAdmin()\n        && d().keys().hasOnly(['maxOvertime', 'share200', 'period'])\n        && d().maxOvertime is number && d().maxOvertime > 0 && d().maxOvertime <= 2000\n        && d().share200 is number && d().share200 >= 0 && d().share200 <= 100\n        && d().period in ['month', 'keret', 'year'];\n    }\n\n    // ---------------- Push értesítés: készülékek (csak a szerver olvassa)\n    match /pushTokens/{token} {\n      allow read: if false;\n      allow create, update: if isLeader()\n        && d().keys().hasOnly(['classId', 'updatedAt'])\n        && d().classId == leaderClass()\n        && d().updatedAt == request.time\n        && token.size() < 400;\n      allow delete: if isLeader();\n    }\n\n    // ---------------- Szabadságkérelmek\n    match /leave/{leaveId} {\n      allow read: if inClass(resource.data.classId) || isAdmin();\n      allow create: if inClass(d().classId)\n        && d().keys().hasOnly(['classId', 'personId', 'personName', 'from', 'to', 'kind', 'note', 'status', 'createdAt'])\n        && d().status == 'függő'\n        && d().from is string && d().to is string && d().from <= d().to\n        && d().personName is string && d().personName.size() <= 80\n        && d().note is string && d().note.size() <= 300\n        && d().createdAt == request.time;\n      // Elbírálni csak a vezető tudja (csak az állapotot és az időpontot módosíthatja)\n      allow update: if leaderOf(resource.data.classId)\n        && d().diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'szDays', 'pDays'])\n        && d().status in ['jóváhagyva', 'elutasítva', 'függő'];\n      // Törölni a vezető bármikor, a dolgozó csak amíg függő (visszavonás)\n      allow delete: if leaderOf(resource.data.classId)\n        || (isWorker() && workerClass() == resource.data.classId && resource.data.status == 'függő');\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-11-09T09:21:48.784351Z","metadata":{"services":["cloud.firestore"]}}
