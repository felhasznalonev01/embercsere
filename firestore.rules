rules_version = '2';

// Embercsere + Szolgálatbeosztás – Firestore biztonsági szabályok.
// Ha a config.js-ben átírod a fiókok e-mail címét, itt is írd át ugyanúgy!

service cloud.firestore {
  match /databases/{database}/documents {

    // Osztályvezetők fiókjai
    function leaderClass() {
      return {
        'osztaly1@example.com': 'o1',
        'osztaly2@example.com': 'o2',
        'osztaly3@example.com': 'o3',
        'osztaly4@example.com': 'o4'
      }.get(request.auth.token.email, 'nincs');
    }
    // Dolgozói (közös) fiókok
    function workerClass() {
      return {
        'dolgozo1@example.com': 'o1',
        'dolgozo2@example.com': 'o2',
        'dolgozo3@example.com': 'o3',
        'dolgozo4@example.com': 'o4'
      }.get(request.auth.token.email, 'nincs');
    }
    // Szolgálatvezetés: minden osztályt lát, írni csak a szolgálati sorrendet tudja
    function isAdmin() { return request.auth != null && request.auth.token.email == 'vezeto@example.com'; }
    function isLeader() { return request.auth != null && leaderClass() != 'nincs'; }
    function isWorker() { return request.auth != null && workerClass() != 'nincs'; }
    function inClass(cid) { return (isLeader() && leaderClass() == cid) || (isWorker() && workerClass() == cid); }
    function leaderOf(cid) { return isLeader() && leaderClass() == cid; }
    function req(id) { return get(/databases/$(database)/documents/requests/$(id)).data; }
    function d() { return request.resource.data; }

    // ---------------- Embercsere: csak osztályvezetők
    match /requests/{requestId} {
      allow read: if isLeader() || isAdmin();
      allow create: if isLeader()
        && d().keys().hasOnly(['classId', 'date', 'shift', 'qty', 'note', 'createdAt'])
        && d().classId == leaderClass()
        && d().date is string && d().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().shift is string && d().shift.size() <= 20
        && d().qty is list && d().qty.size() <= 10
        && d().note is string && d().note.size() <= 500
        && d().createdAt == request.time;
      allow delete: if leaderOf(resource.data.classId);
      allow update: if false;
    }

    match /offers/{offerId} {
      allow read: if isLeader() || isAdmin();
      allow create: if isLeader()
        && d().keys().hasOnly(['requestId', 'roleIndex', 'slot', 'classId', 'person', 'personId', 'date', 'shift', 'toClassId', 'createdAt'])
        && d().classId == leaderClass()
        && d().person is string && d().person.size() > 0 && d().person.size() <= 100
        && d().personId is string && d().personId.size() <= 60
        && d().roleIndex is int && d().roleIndex >= 0
        && d().slot is int && d().slot >= 0
        && offerId == d().requestId + '_' + string(d().roleIndex) + '_' + string(d().slot)
        && req(d().requestId).classId != leaderClass()
        && d().toClassId == req(d().requestId).classId
        && d().date == req(d().requestId).date
        && d().shift == req(d().requestId).shift
        && d().roleIndex < req(d().requestId).qty.size()
        && d().slot < req(d().requestId).qty[d().roleIndex]
        && d().createdAt == request.time;
      // Visszavonhatja aki adta, vagy akinek a kérése
      allow delete: if isLeader()
        && (resource.data.classId == leaderClass() || resource.data.toClassId == leaderClass());
      allow update: if false;
    }

    // ---------------- Névsor: vezető szerkeszti, a dolgozók csak olvassák (a saját osztályukét)
    match /people/{personId} {
      allow read: if inClass(resource.data.classId) || isAdmin();
      allow create: if leaderOf(d().classId)
        && d().keys().hasOnly(['classId', 'name', 'pattern', 'role', 'active', 'leaveDays', 'exams', 'createdAt'])
        && d().name is string && d().name.size() > 0 && d().name.size() <= 80
        && d().pattern in ['12', '24'];
      allow update: if leaderOf(resource.data.classId) && d().classId == resource.data.classId
        && d().keys().hasOnly(['classId', 'name', 'pattern', 'role', 'active', 'leaveDays', 'exams', 'createdAt'])
        && d().name is string && d().name.size() > 0 && d().name.size() <= 80
        && d().pattern in ['12', '24'];
      allow delete: if leaderOf(resource.data.classId);
    }

    // ---------------- Beosztás: havonta egy dokumentum osztályonként ("o1_2026-11"), csak a vezető
    match /roster/{docId} {
      allow read: if (isLeader() && docId.split('_')[0] == leaderClass()) || isAdmin();
      allow write: if isLeader() && docId == leaderClass() + '_' + d().month
        && d().classId == leaderClass()
        && d().month is string && d().month.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // ---------------- Osztály-beállítások (napi cél-létszám)
    match /classSettings/{cid} {
      allow read: if leaderOf(cid) || isAdmin();
      allow write: if leaderOf(cid) && d().classId == cid && d().target is number;
    }

    // ---------------- Szolgálati sorrend (melyik nap melyik osztály van szolgálatban)
    match /settings/rotation {
      allow read: if isLeader() || isWorker() || isAdmin();
      allow write: if isAdmin()
        && d().keys().hasOnly(['start', 'order'])
        && d().start is string && d().start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().order is list && d().order.size() >= 1 && d().order.size() <= 10;
    }

    // ---------------- Túlóra-korlát és célarány (csak a szolgálatvezetés állítja)
    match /settings/limits {
      allow read: if isLeader() || isAdmin();
      allow write: if isAdmin()
        && d().keys().hasOnly(['maxOvertime', 'share200', 'period'])
        && d().maxOvertime is number && d().maxOvertime > 0 && d().maxOvertime <= 2000
        && d().share200 is number && d().share200 >= 0 && d().share200 <= 100
        && d().period in ['month', 'keret', 'year'];
    }

    // ---------------- Szabadságkérelmek
    match /leave/{leaveId} {
      allow read: if inClass(resource.data.classId) || isAdmin();
      allow create: if inClass(d().classId)
        && d().keys().hasOnly(['classId', 'personId', 'personName', 'from', 'to', 'kind', 'note', 'status', 'createdAt'])
        && d().status == 'függő'
        && d().from is string && d().to is string && d().from <= d().to
        && d().personName is string && d().personName.size() <= 80
        && d().note is string && d().note.size() <= 300
        && d().createdAt == request.time;
      // Elbírálni csak a vezető tudja (csak az állapotot és az időpontot módosíthatja)
      allow update: if leaderOf(resource.data.classId)
        && d().diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
        && d().status in ['jóváhagyva', 'elutasítva', 'függő'];
      // Törölni a vezető bármikor, a dolgozó csak amíg függő (visszavonás)
      allow delete: if leaderOf(resource.data.classId)
        || (isWorker() && workerClass() == resource.data.classId && resource.data.status == 'függő');
    }
  }
}
